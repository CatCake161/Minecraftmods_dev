{
	"schemaVersion": 1,
	"id": "firstmod",
	"version": "${version}",
	"name": "First Mod",
	"description": "A starter Fabric mod for Minecraft 1.21.1.",
	"authors": [
		"Cinema Project"
	],
	"license": "CC0-1.0",
	"icon": "assets/firstmod/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.example.firstmod.FirstMod"
		],
		"client": [
			"com.example.firstmod.client.FirstModClient"
		]
	},
	"mixins": [
		"firstmod.mixins.json",
		{
			"config": "firstmod.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~1.21.1",
		"java": ">=21",
		"fabric-api": "*"
	}
}

{
	"schemaVersion": 1,
	"id": "cinema",
	"version": "${version}",
	"name": "Cinema",
	"description": "A Minecraft cinema system with screens, projectors, AV receivers, and speakers.",
	"authors": [
		"Cinema Project"
	],
	"license": "CC0-1.0",
	"icon": "assets/cinema/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.example.cinema.Cinema"
		],
		"client": [
			"com.example.cinema.client.CinemaClient"
		],
		"modmenu": [
			"com.example.cinema.client.config.CinemaModMenuIntegration"
		]
	},
	"mixins": [
		"cinema.mixins.json",
		{
			"config": "cinema.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~1.21.1",
		"java": ">=21",
		"fabric-api": "*"
	}
}

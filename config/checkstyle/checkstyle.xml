<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
	"-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
	"https://checkstyle.org/dtds/configuration_1_3.dtd">
<module name="Checker">
	<property name="charset" value="UTF-8"/>

	<module name="TreeWalker">
		<!-- Package names stay all-lowercase, dot-separated. -->
		<module name="PackageName">
			<property name="format" value="^[a-z]+(\.[a-z][a-z0-9]*)*$"/>
		</module>

		<!-- Classes, interfaces, enums and records use UpperCamelCase. -->
		<module name="TypeName"/>

		<!--
			Methods use lowerCamelCase. Mixin accessors use the standard
			"modid$member" form, so '$' is allowed after the first character.
		-->
		<module name="MethodName">
			<property name="format" value="^[a-z][a-zA-Z0-9]*(\$[a-zA-Z0-9]+)*$"/>
		</module>

		<!-- Instance and static non-final fields use lowerCamelCase. -->
		<module name="MemberName"/>
		<module name="StaticVariableName"/>

		<!--
			Static final constants use UPPER_SNAKE_CASE. Private fields are
			excluded because the project deliberately names private static
			final mutable collections in lowerCamelCase.
		-->
		<module name="ConstantName">
			<property name="applyToPrivate" value="false"/>
		</module>
	</module>
</module>
